+        asset = InvestmentAsset(
+            name="삼성전자",
+            asset_type=AssetType.STOCK,
+            quantity=100,
+            unit_price=Money(amount=Decimal("85000"), currency="KRW"),
+        )
+        portfolio = Portfolio(assets=[asset])
+        analyze_use_case = AnalyzePortfolio()
